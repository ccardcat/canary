{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canary",
  "version": "0.1.1",
  "identifier": "com.canary.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Canary",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Canary/instances/*/screenshots/**",
          "$LOCALDATA/Canary/cache/icons/**",
          "$LOCALDATA/Canary/wallpapers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
