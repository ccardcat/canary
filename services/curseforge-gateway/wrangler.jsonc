{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canaryclientcurseforge",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "keep_vars": true,
  "ratelimits": [
    { "name": "API_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "DOWNLOAD_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "BUDGET_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 5000, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
